# Future full-system cutover configuration. Do not replace the running sample yet.
# Caddy must share the full-system network; only Caddy publishes 80/443.

(gateway_proxy) {
    reverse_proxy gateway:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up -X-User-Id
        header_up -X-User-Role
        header_up -X-Room-Number
    }
}

forever-hotel-staging.malaysiawest.cloudapp.azure.com {
    @gateway_paths path /auth /auth/* /hw /hw/* /realtime /realtime/*
    handle @gateway_paths {
        import gateway_proxy
    }
    # Keep /api/* and /_next/* on Next.js, including BFF authentication.
    handle {
        reverse_proxy hw-frontend:3001
    }
}

