{
  "schemaVersion": 1,
  "description": "Public, non-secret build settings for service image-publication workflows. This file is consumed manually until CI wiring is implemented.",
  "services": {
    "hw-frontend": {
      "repository": "hotel-website",
      "branch": "develop",
      "context": "frontend",
      "args": {
        "ROOM_IMAGE_HOSTS": ""
      }
    },
    "mad-frontend": {
      "repository": "manager-dashboard",
      "branch": "development",
      "context": "frontend",
      "args": {
        "NEXT_PUBLIC_API_URL": "https://forever-hotel-manager.duckdns.org"
      }
    },
    "fds-frontend": {
      "repository": "front-desk",
      "branch": "develop",
      "context": "frontend",
      "args": {
        "NEXT_PUBLIC_API_BASE_URL": "https://forever-hotel-frontdesk.duckdns.org/fds",
        "NEXT_PUBLIC_WS_URL": "https://forever-hotel-frontdesk.duckdns.org"
      }
    },
    "foss-frontend": {
      "repository": "food-ordering",
      "branch": "develop",
      "context": "frontend",
      "args": {
        "NEXT_PUBLIC_API_URL": "https://forever-hotel-food.duckdns.org/foss",
        "NEXT_PUBLIC_GATEWAY_URL": "https://forever-hotel-food.duckdns.org",
        "NEXT_PUBLIC_DATA_MODE": "api",
        "NEXT_PUBLIC_ALLOW_DEMO_PREVIEW": "false"
      }
    },
    "wkms-frontend": {
      "repository": "worker-management",
      "branch": "develop",
      "context": "frontend",
      "args": {
        "NEXT_PUBLIC_API_GATEWAY_URL": "https://forever-hotel-workers.duckdns.org/wms",
        "NEXT_PUBLIC_WKMS_SOCKET_URL": "https://forever-hotel-workers.duckdns.org"
      }
    },
    "kms-frontend": {
      "repository": "kitchen-management",
      "branch": "develop",
      "context": "frontend",
      "args": {},
      "runtimeSettings": [
        "API_GATEWAY_URL",
        "APP_ORIGIN",
        "SHARED_WEBSOCKET_URL",
        "KMS_SOCKET_PUBLIC_URL",
        "KMS_WEBSOCKET_RELAY_KEY",
        "KMS_SESSION_ENCRYPTION_KEY"
      ],
      "note": "Secret values belong only in private runtime env files; never build arguments."
    }
  }
}
