# Reconstructed review snapshot, not a verified live export. KMS intentionally excluded.
# Transition only: reuse the EXISTING sample Caddy and certificate volumes.
(shared_gateway) {
    reverse_proxy shared-gateway:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up -X-User-Id
        header_up -X-User-Role
        header_up -X-Room-Number
    }
}
forever-hotel-staging.malaysiawest.cloudapp.azure.com {
    @hw path /hw /hw/*
    handle @hw {
        import shared_gateway
    }
    handle {
        reverse_proxy hotel-website-frontend:3001
    }
}
forever-hotel-manager.duckdns.org {
    @mad path /auth /auth/* /mad /mad/* /realtime /realtime/*
    handle @mad {
        import shared_gateway
    }
    handle {
        reverse_proxy mad-frontend:3000
    }
}

forever-hotel-frontdesk.duckdns.org {
    @gateway_paths path /auth /auth/* /fds /fds/* /realtime /realtime/*
    handle @gateway_paths {
        import shared_gateway
    }
    handle {
        reverse_proxy fds-frontend:3001
    }
}

forever-hotel-food.duckdns.org {
    @gateway_paths path /auth /auth/* /foss /foss/* /realtime /realtime/*
    handle @gateway_paths {
        import shared_gateway
    }
    handle {
        reverse_proxy foss-frontend:3000
    }
}

forever-hotel-workers.duckdns.org {
    @gateway_paths path /auth /auth/* /wms /wms/* /wkms /wkms/* /realtime /realtime/*
    handle @gateway_paths {
        import shared_gateway
    }
    handle {
        reverse_proxy wkms-frontend:3001
    }
}
