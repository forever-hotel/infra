# Source: front-desk/frontend/.env.example
# TEMPLATE ONLY: replace local URLs and example credentials before startup.
# See docs/DEPLOYMENT.md for internal URLs and unresolved rollout gates.
# Example for local development with the shared API Gateway and shared WebSocket service.
# For deployment, configure browser-reachable HTTPS/WSS URLs at build time.
NEXT_PUBLIC_API_BASE_URL=https://forever-hotel-frontdesk.duckdns.org/fds
NEXT_PUBLIC_WS_URL=https://forever-hotel-frontdesk.duckdns.org
# Staff authentication uses the same-origin BFF.
API_GATEWAY_INTERNAL_URL=http://gateway:8080
APP_ORIGIN=https://forever-hotel-frontdesk.duckdns.org
PORT=3001
SHARED_WEBSOCKET_URL=http://websocket:8081
WEBSOCKET_RELAY_KEY=replace-with-this-subsystems-private-relay-key
