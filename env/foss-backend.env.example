# Source: food-ordering/backend/.env.example
# TEMPLATE ONLY: replace local URLs and example credentials before startup.
# See docs/DEPLOYMENT.md for internal URLs and unresolved rollout gates.
PORT=4300

# API Gateway Ingress Prefix Normalization
# Unmodified Forever Hotel API Gateway forwards /foss/* with rewritePrefix: "/foss".
# FOSS ingress middleware normalizes /${API_PREFIX}/* to /* (default: foss).
API_PREFIX=foss

# Neon PostgreSQL (Development / Staging / Production)
# Use the pooled connection URL with SSL enabled per Neon configuration:
# DATABASE_URL=postgresql://<role>:<password>@ep-sample-pooler.<region>.neon.tech/<dbname>?sslmode=require
#
# Dedicated Neon Test Branch Allowlist (Server-Side Isolation Configuration)
# Configure explicit project, branch, and endpoint IDs for the dedicated test child branch.
# In non-test environments or when unconfigured, write-capable testing is blocked (fails closed).
APPROVED_NEON_PROJECT_ID=project-id-placeholder
APPROVED_NEON_TEST_BRANCH_ID=br-test-branch-placeholder
APPROVED_NEON_TEST_ENDPOINT_ID=ep-test-endpoint-placeholder
PARENT_DEV_BRANCH_ID=br-parent-dev-branch-placeholder
#
# Local development fallback (when running local docker-compose postgres):
DATABASE_HOST=REPLACE_SHARED_NEON_HOST
DATABASE_PORT=5432
DATABASE_NAME=forever
DATABASE_USER=REPLACE_PRIVATE_DATABASE_ROLE
DATABASE_PASSWORD=REPLACE_PRIVATE_DATABASE_PASSWORD
DATABASE_URL=postgresql://REPLACE_ROLE:REPLACE_PASSWORD@REPLACE_SHARED_NEON_HOST/forever?sslmode=require

# RabbitMQ Messaging (SDS §1.4, DDP-160, CIT-04)
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://REPLACE_USER:REPLACE_PASSWORD@rabbitmq:5672/forever_hotel

# Optional Redis Cache (DDP-159, CR-2026-005, Proposed)
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
REDIS_TTL_SECONDS=300

FRONTEND_URL=https://forever-hotel-food.duckdns.org
FOSS_PUBLIC_APP_URL=https://forever-hotel-food.duckdns.org
SHARED_DATABASE_MODE=true
SHARED_WEBSOCKET_URL=http://websocket:8081
# Must match the FOSS relayKey in websocket.env; provision privately.
WEBSOCKET_RELAY_KEY=REPLACE_WITH_PRIVATE_FOSS_RELAY_KEY_AT_LEAST_32_CHARACTERS

# Service integration controls
# Enable mock providers for local development and demo only (fail-closed in production)
MOCK_EXTERNAL_SERVICES=false
DEMO_MODE=false

# Authoritative Front Desk Subsystem (FDS/HW) Booking provider configuration
FDS_BOOKING_SERVICE_URL=http://fds-backend:4001
FDS_BOOKING_SERVICE_API_KEY=example-fds-api-key

# QR Code Proof & Session Lifecycle configuration
QR_SIGNING_SECRET=development-demo-qr-signing-secret-at-least-32-chars-long
SESSION_TTL_HOURS=24

# Internal FDS Event & Webhook authentication (DDP-125)
INTERNAL_SERVICE_KEY=development-internal-service-key-at-least-32-chars
FDS_WEBHOOK_SECRET=development-fds-webhook-secret-at-least-32-chars

# Upstream Subsystem URLs (DDP-127: KMS, WKMS, MAD)
KMS_SERVICE_URL=http://kms-backend:4005
# Match KMS_ORDER_INTAKE_TOKEN in kms-backend.env.
KMS_SERVICE_API_KEY=REPLACE_WITH_PRIVATE_KMS_INTAKE_TOKEN_AT_LEAST_32_CHARACTERS
WKMS_SERVICE_URL=http://wkms-backend:3000
# Match FDS_WKMS_SERVICE_TOKEN in wkms-backend.env.
WKMS_SERVICE_API_KEY=REPLACE_WITH_PRIVATE_WKMS_SERVICE_TOKEN_AT_LEAST_32_CHARACTERS
MAD_SERVICE_URL=https://mad.internal.foreverhotel.com
MAD_SERVICE_API_KEY=example-mad-api-key
