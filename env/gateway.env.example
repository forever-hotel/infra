# TEMPLATE ONLY: replace local URLs and sample secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Upstreams are internal Docker DNS names. Route activation is separate.
# Check each backend's path mappings and cookie names in config/routes.json.
MAD_SERVICE_URL=http://mad-backend:4000
HW_SERVICE_URL=http://hw-backend:3000
FDS_SERVICE_URL=http://fds-backend:4001
FOSS_SERVICE_URL=http://foss-backend:4300
KMS_SERVICE_URL=http://kms-backend:4005
WKMS_SERVICE_URL=http://wkms-backend:3000
# Enable the optional /realtime route when the shared WebSocket service is running.
WEBSOCKET_SERVICE_URL=http://websocket:8081
# Exact frontend origins; replace these example ports with your actual origins.
ALLOWED_ORIGINS=https://forever-hotel-staging.malaysiawest.cloudapp.azure.com,https://forever-hotel-manager.duckdns.org,https://forever-hotel-frontdesk.duckdns.org,https://forever-hotel-food.duckdns.org,https://forever-hotel-workers.duckdns.org,https://forever-hotel-kitchen.duckdns.org
TRUSTED_PROXIES=
# In-memory limits per gateway process; counters reset on restart.
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576
RESPONSE_LIMIT_BYTES=10485760
UPSTREAM_TIMEOUT_MS=4000
HEALTH_TIMEOUT_MS=2000
ROUTES_FILE=config/routes.json
# Backend cookie names must match cookieNames in routes.json.
# Browser requests using cookies must set credentials: 'include'.

# Central staff authentication (all staff roles; guest authentication remains separate).
STAFF_AUTH_ENABLED=true
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_USERNAME=your-runtime-role
DB_PASSWORD=your-private-database-password
DB_NAME=forever
DB_SSL=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=forever-hotel
# Apply sql/manager-password-reset.sql manually before email recovery.
STAFF_EMAIL_ENABLED=true
BREVO_API_KEY=
STAFF_EMAIL_FROM=
WMS_SERVICE_URL=http://wkms-backend:3000
