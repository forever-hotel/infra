# Source: manager-dashboard/frontend/.env.example
# TEMPLATE ONLY: replace local URLs and example credentials before startup.
# See docs/DEPLOYMENT.md for internal URLs and unresolved rollout gates.
NEXT_PUBLIC_API_URL=https://forever-hotel-manager.duckdns.org
# Server-only settings; never prefix these with NEXT_PUBLIC.
BACKEND_API_URL=http://gateway:8080
BACKEND_API_MODE=gateway
APP_ORIGIN=https://forever-hotel-manager.duckdns.org

# Browser-reachable Socket.IO origin; REST still uses the API gateway.
MAD_SOCKET_PUBLIC_URL=https://forever-hotel-manager.duckdns.org

# Backend-only settings: configure real values in root .env (Compose) or backend/.env.
# These blank entries are unused here; never expose credentials using NEXT_PUBLIC_ variables.
STAFF_CREDENTIALS_KEY=
STAFF_EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
